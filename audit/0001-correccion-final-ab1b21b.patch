+-- Comprobación explícita de duplicados históricos antes de crear UNIQUE (company_id, po_number):
+-- si existen duplicados, la migración se detiene sin borrar, renumerar ni sobrescribir órdenes históricas.
+do $$
+declare
+  v_dups text;
