-- ============================================================================
-- SUITE AMPLIADA DE AUDITORÍA (DISEÑADA, NO EJECUTADA)
-- Requiere 000062 y 000063 aplicadas. No persiste cambios (ROLLBACK final).
-- ============================================================================
BEGIN;

DO $$
DECLARE
  v_co uuid := 'f58a80c2-3b6d-42ba-b5bc-62fe87fcc334';
  v_other_co uuid;
  v_uid_dueno uuid;
  v_uid_admin_emp uuid;
  v_uid_plat_admin uuid;
