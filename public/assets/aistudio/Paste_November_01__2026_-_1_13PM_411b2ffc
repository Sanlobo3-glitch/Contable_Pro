[
  {
    "diagnostico_cuentas_por_pagar": "{\n    \"columnas\": {\n        \"purchases\": \"id uuid default gen_random_uuid()\\nsupplier_id uuid\\nsupplier_name text\\nitems jsonb default '[]'::jsonb\\ntotal numeric default 0\\nstatus text default 'recibida'::text\\ncreated_at timestamp with time zone default now()\\ncompany_id uuid default current_company_id()\",\n        \"suppliers\": \"id uuid default gen_random_uuid()\\nname text\\ndocument text\\nemail text\\nphone text\\naddress text\\ncreated_at timestamp with time zone default now()\\ncompany_id uuid default current_company_id()\",\n        \"acc_settings\": \"company_id uuid\\nstart_date date\\nactive boolean default false\\ntimezone text default 'America/Caracas'::text\\nmap jsonb default '{}'::jsonb\\nupdated_at timestamp with time zone default now()\",\n        \"cash_entries\": \"id uuid default gen_random_uuid()\\ntype text\\namount numeric default 0\\ndescription text default ''::text\\nreference_type text\\nreference_id uuid\\ncreated_at timestamp with time zone default now()\\ncompany_id uuid default current_company_id()\",\n        \"credit_payments\": \"id uuid default gen_random_uuid()\\ncompany_id uuid\\ncustomer_id uuid\\namount numeric\\nmethod text\\nnote text\\nstatus text default 'activo'::text\\nclient_uuid uuid\\ncreated_by uuid\\ncreated_by_name text\\ncreated_at timestamp with time zone default now()\",\n        \"customer_credit\": \"id uuid default gen_random_uuid()\\ncompany_id uuid\\ncustomer_id uuid\\ncredit_limit numeric default 0\\ncredit_days integer default 30\\nupdated_at timestamp with time zone default now()\",\n        \"credit_allocations\": \"id uuid default gen_random_uuid()\\ncompany_id uuid\\npayment_id uuid\\nsale_id uuid\\namount numeric\"\n    },\n    \"funciones\": {\n        \"cxc_config()\": \"CREATE OR REPLACE FUNCTION public.cxc_config()\\n RETURNS jsonb\\n LANGUAGE plpgsql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\ndeclare v_co uuid := public._ctx(array['admin', 'dueno']); v_acc uuid; v_active boolean := false; a acc_accounts%rowtype;\\nbegin\\n  select account_id into v_acc from cxc_settings where company_id = v_co;\\n  select coalesce(active, false) into v_active from acc_settings where company_id = v_co;\\n  if v_acc is not null then select * into a from acc_accounts where id = v_acc and company_id = v_co; end if;\\n  return jsonb_build_object('account_id', v_acc, 'account_code', a.code, 'account_name', a.name,\\n                            'accounting_active', coalesce(v_active, false));\\nend $function$\\n\",\n        \"acc_reconcile()\": \"CREATE OR REPLACE FUNCTION public.acc_reconcile()\\n RETURNS TABLE(code text, label text, operational numeric, accounting numeric, difference numeric, note text)\\n LANGUAGE plpgsql\\n STABLE SECURITY DEFINER\\n SET search_path TO ''\\nAS $function$\\ndeclare v_c uuid := public.my_company(); s public.acc_settings; a numeric; b numeric; k int; x uuid;\\nbegin\\nif not public.is_manager() or v_c is null then raise exception 'No autorizado'; end if;\\nselect * into s from public.acc_settings where company_id = v_c;\\nif not found or s.start_date is null then\\nraise exception 'Configura y activa la contabilidad automática antes de conciliar';\\nend if;\\n\\nselect coalesce(sum(x.total - x.tax_amount), 0) into a from public.sales x\\nwhere x.company_id = v_c and x.status = 'completada' and (x.created_at at time zone s.timezone)::date >= s.start_date;\\nselect coalesce(sum(l.credit - l.debit), 0) into b\\nfrom public.acc_lines l join public.acc_entries e on e.id = l.entry_id\\nwhere e.company_id = v_c and e.source_type = 'venta' and e.status = 'contabilizado'\\nand l.account_id = (s.map->>'ventas')::uuid;\\ncode := 'ventas'; label := 'Ventas sin impuesto'; operational := a; accounting := b; difference := a - b;\\nnote := 'Debe ser 0'; return next;\\n\\nselect count(*) into k from public.sales x\\nwhere x.company_id = v_c and x.status = 'completada' and jsonb_array_length(x.items) > 0\\nand (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'venta'\\nand e.source_id = x.id and e.source_event = 'registro');\\ncode := 'ventas_pendientes'; label := 'Ventas sin contabilizar (cantidad)'; operational := k; accounting := 0;\\ndifference := k; note := 'Si hay pendientes, usa \\\"Contabilizar pendientes\\\"'; return next;\\n\\nselect coalesce(sum(x.total), 0) into a from public.purchases x\\nwhere x.company_id = v_c and x.status = 'recibida' and (x.created_at at time zone s.timezone)::date >= s.start_date;\\nselect coalesce(sum(l.debit - l.credit), 0) into b\\nfrom public.acc_lines l join public.acc_entries e on e.id = l.entry_id\\nwhere e.company_id = v_c and e.source_type = 'compra' and e.status = 'contabilizado'\\nand l.account_id = (s.map->>'inventario')::uuid;\\ncode := 'compras'; label := 'Compras recibidas'; operational := a; accounting := b; difference := a - b;\\nnote := 'Debe ser 0'; return next;\\n\\nselect count(*) into k from public.devolutions x\\nwhere x.company_id = v_c and (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'devolucion'\\nand e.source_id = x.id and e.source_event = 'registro');\\ncode := 'devoluciones_pendientes'; label := 'Devoluciones sin contabilizar (cantidad)'; operational := k;\\naccounting := 0; difference := k; note := 'Debe ser 0'; return next;\\n\\nselect count(*) into k from public.kardex x\\nwhere x.company_id = v_c and x.reference_type = 'ajuste' and (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'ajuste_stock'\\nand e.source_id = x.id and e.source_event = 'registro');\\ncode := 'ajustes_pendientes'; label := 'Ajustes de stock sin contabilizar (cantidad)'; operational := k;\\naccounting := 0; difference := k;\\nnote := 'Si hay pendientes, configura la cuenta de ajustes de inventario'; return next;\\n\\nselect coalesce(sum(case when c.type = 'ingreso' then c.amount else -c.amount end), 0) into a\\nfrom public.cash_entries c\\nwhere c.company_id = v_c and (c.created_at at time zone s.timezone)::date >= s.start_date;\\nselect coalesce(sum(l.debit - l.credit), 0) into b\\nfrom public.acc_lines l join public.acc_entries e on e.id = l.entry_id\\nwhere e.company_id = v_c and e.status in ('contabilizado', 'reversado') and e.entry_date >= s.start_date\\nand l.account_id = (s.map->>'caja')::uuid;\\ncode := 'caja'; label := 'Movimiento de caja desde el inicio'; operational := a; accounting := b;\\ndifference := a - b; note := 'Debe ser 0 cuando no haya movimientos pendientes'; return next;\\n\\nselect coalesce(sum(case when c.type = 'ingreso' then c.amount else -c.amount end), 0) into a\\nfrom public.cash_entries c\\nwhere c.company_id = v_c and (c.reference_type is null or c.reference_type = 'arqueo')\\nand (c.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c\\nand e.source_type in ('caja', 'arqueo') and e.source_id = c.id and e.source_event = 'registro');\\ncode := 'caja_pendiente'; label := 'Caja manual y arqueos sin contabilizar'; operational := a; accounting := 0;\\ndifference := a; note := 'Si hay pendientes, configura Gastos y Otros ingresos'; return next;\\n\\nselect coalesce(sum(p.stock * p.cost), 0) into a from public.products p where p.company_id = v_c;\\nselect coalesce(sum(l.debit - l.credit), 0) into b\\nfrom public.acc_lines l join public.acc_entries e on e.id = l.entry_id\\nwhere e.company_id = v_c and e.status in ('contabilizado', 'reversado')\\nand l.account_id = (s.map->>'inventario')::uuid;\\ncode := 'inventario'; label := 'Inventario'; operational := a; accounting := b; difference := a - b;\\nnote := 'Valorado al último costo. La contabilidad empieza en cero salvo que cargues un asiento de apertura';\\nreturn next;\\n\\nselect account_id into x from public.cxc_settings where company_id = v_c;\\nif x is not null then\\nselect coalesce(sum(public._sale_balance(f.id)), 0) into a from public.sales f\\nwhere f.company_id = v_c and f.payment_method = 'fiado' and f.status = 'completada'\\nand (f.created_at at time zone s.timezone)::date >= s.start_date;\\nselect coalesce(sum(l.debit - l.credit), 0) into b\\nfrom public.acc_lines l join public.acc_entries e on e.id = l.entry_id\\nwhere e.company_id = v_c and e.status in ('contabilizado', 'reversado') and l.account_id = x;\\ncode := 'cartera'; label := 'Cartera de clientes (fiado)'; operational := a; accounting := b;\\ndifference := a - b;\\nnote := 'Debe ser 0 cuando no haya pendientes. Una devolución con descuento o impuesto puede dejar una diferencia pequeña';\\nreturn next;\\n\\nselect count(*) into k from public.credit_payments y\\nwhere y.company_id = v_c and y.status = 'activo' and (y.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'abono'\\nand e.source_id = y.id and e.source_event = 'registro');\\ncode := 'abonos_pendientes'; label := 'Abonos de clientes sin contabilizar (cantidad)'; operational := k;\\naccounting := 0; difference := k; note := 'Si hay pendientes, usa \\\"Contabilizar pendientes\\\"'; return next;\\nend if;\\nend $function$\\n\",\n        \"acc_post_pending()\": \"CREATE OR REPLACE FUNCTION public.acc_post_pending()\\n RETURNS jsonb\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO ''\\nAS $function$\\ndeclare\\nv_c uuid := public.my_company(); s public.acc_settings;\\nr public.sales; q public.purchases; d public.devolutions; c public.cash_entries; k public.kardex;\\npp public.credit_payments;\\nv_s int := 0; v_p int := 0; v_d int := 0; v_k int := 0; v_a int := 0; v_ab int := 0;\\nbegin\\nif not public.is_manager() or v_c is null then raise exception 'No autorizado'; end if;\\nselect * into s from public.acc_settings where company_id = v_c;\\nif not found or not s.active then raise exception 'Activa primero la contabilidad automática'; end if;\\nfor r in\\nselect * from public.sales x\\nwhere x.company_id = v_c and x.status = 'completada' and jsonb_array_length(x.items) > 0\\nand (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'venta'\\nand e.source_id = x.id and e.source_event = 'registro')\\norder by x.created_at\\nloop\\nif public.acc_post_sale(r, true) is not null then v_s := v_s + 1; end if;\\nend loop;\\nfor q in\\nselect * from public.purchases x\\nwhere x.company_id = v_c and x.status = 'recibida' and jsonb_array_length(x.items) > 0\\nand (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'compra'\\nand e.source_id = x.id and e.source_event = 'registro')\\norder by x.created_at\\nloop\\nif public.acc_post_purchase(q, true) is not null then v_p := v_p + 1; end if;\\nend loop;\\nfor d in\\nselect * from public.devolutions x\\nwhere x.company_id = v_c and (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'devolucion'\\nand e.source_id = x.id and e.source_event = 'registro')\\norder by x.created_at\\nloop\\nif public.acc_post_devolution(d, true) is not null then v_d := v_d + 1; end if;\\nend loop;\\nfor c in\\nselect * from public.cash_entries x\\nwhere x.company_id = v_c and (x.reference_type is null or x.reference_type = 'arqueo')\\nand (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c\\nand e.source_type in ('caja', 'arqueo') and e.source_id = x.id and e.source_event = 'registro')\\norder by x.created_at\\nloop\\nif public.acc_post_cash(c, true) is not null then v_k := v_k + 1; end if;\\nend loop;\\nfor k in\\nselect * from public.kardex x\\nwhere x.company_id = v_c and x.reference_type = 'ajuste'\\nand (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'ajuste_stock'\\nand e.source_id = x.id and e.source_event = 'registro')\\norder by x.created_at\\nloop\\nif public.acc_post_adjustment(k, true) is not null then v_a := v_a + 1; end if;\\nend loop;\\nfor pp in\\nselect * from public.credit_payments x\\nwhere x.company_id = v_c and x.status = 'activo'\\nand (x.created_at at time zone s.timezone)::date >= s.start_date\\nand not exists (select 1 from public.acc_entries e where e.company_id = v_c and e.source_type = 'abono'\\nand e.source_id = x.id and e.source_event = 'registro')\\norder by x.created_at\\nloop\\nif public.acc_post_payment(pp.id) is not null then v_ab := v_ab + 1; end if;\\nend loop;\\nreturn jsonb_build_object('ventas', v_s, 'compras', v_p, 'devoluciones', v_d, 'caja', v_k, 'ajustes', v_a, 'abonos', v_ab);\\nend $function$\\n\",\n        \"cartera_clientes()\": \"CREATE OR REPLACE FUNCTION public.cartera_clientes()\\n RETURNS jsonb\\n LANGUAGE plpgsql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\ndeclare v_co uuid := public._ctx(null); v_today date := public._co_today(v_co); v_res jsonb;\\nbegin\\n  with b as (\\n    select s.customer_id, s.id, s.due_date, public._sale_balance(s.id) as bal\\n    from sales s\\n    where s.company_id = v_co and s.payment_method = 'fiado' and s.status = 'completada' and s.customer_id is not null\\n  ), agg as (\\n    select c.id, c.name, c.document, c.phone,\\n           coalesce(sum(b.bal), 0) as owed,\\n           coalesce(sum(b.bal) filter (where b.due_date is not null and b.due_date < v_today), 0) as overdue,\\n           min(b.due_date) filter (where b.bal > 0.004) as oldest_due,\\n           (count(b.id) filter (where b.bal > 0.004))::int as open_sales,\\n           coalesce(cc.credit_limit, 0) as credit_limit,\\n           coalesce(cc.credit_days, 30) as credit_days,\\n           (select max(p.created_at) from credit_payments p where p.customer_id = c.id and p.status = 'activo') as last_payment\\n    from customers c\\n    left join b on b.customer_id = c.id\\n    left join customer_credit cc on cc.customer_id = c.id\\n    where c.company_id = v_co\\n    group by c.id, c.name, c.document, c.phone, cc.credit_limit, cc.credit_days\\n    having coalesce(sum(b.bal), 0) > 0.004 or coalesce(cc.credit_limit, 0) > 0\\n  )\\n  select jsonb_build_object(\\n    'today', v_today,\\n    'total_owed', coalesce((select sum(owed) from agg), 0),\\n    'total_overdue', coalesce((select sum(overdue) from agg), 0),\\n    'customers', coalesce((select jsonb_agg(jsonb_build_object(\\n        'customer_id', id, 'name', name, 'document', document, 'phone', phone,\\n        'owed', owed, 'overdue', overdue, 'oldest_due', oldest_due, 'open_sales', open_sales,\\n        'credit_limit', credit_limit, 'credit_days', credit_days, 'last_payment', last_payment)\\n        order by overdue desc, owed desc, name) from agg), '[]'::jsonb))\\n  into v_res;\\n  return v_res;\\nend $function$\\n\",\n        \"_ctx(p_roles text[])\": \"CREATE OR REPLACE FUNCTION public._ctx(p_roles text[] DEFAULT NULL::text[])\\n RETURNS uuid\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n                        declare p profiles%rowtype;\\n                        begin\\n                          select * into p from profiles where id = auth.uid();\\n                            if not found or not p.active or p.company_id is null then\\n                                raise exception 'Usuario no autorizado';\\n                                  end if;\\n                                    if p_roles is not null and not (p.role = any (p_roles)) then\\n                                        raise exception 'No tienes permiso para esta operación';\\n                                          end if;\\n                                            return p.company_id;\\n                                            end $function$\\n\",\n        \"_es_finito(n numeric)\": \"CREATE OR REPLACE FUNCTION public._es_finito(n numeric)\\n RETURNS boolean\\n LANGUAGE sql\\n IMMUTABLE\\n SET search_path TO ''\\nAS $function$ select n is not null and n <> 'NaN'::numeric\\n        and n <> 'Infinity'::numeric and n <> '-Infinity'::numeric $function$\\n\",\n        \"_sale_balance(p_sale_id uuid)\": \"CREATE OR REPLACE FUNCTION public._sale_balance(p_sale_id uuid)\\n RETURNS numeric\\n LANGUAGE sql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n  select case\\n    when s.payment_method <> 'fiado' or s.status <> 'completada' then 0\\n    when coalesce((select sum(d.quantity) from devolutions d where d.sale_id = s.id), 0)\\n         >= coalesce((select sum((x->>'quantity')::numeric) from jsonb_array_elements(s.items) x), 0)\\n         and jsonb_array_length(s.items) > 0 then 0\\n    else greatest(\\n      s.total\\n      - coalesce((select sum(d.amount) from devolutions d where d.sale_id = s.id), 0)\\n      - coalesce((select sum(a.amount) from credit_allocations a\\n                  join credit_payments p on p.id = a.payment_id\\n                  where a.sale_id = s.id and p.status = 'activo'), 0), 0)\\n  end\\n  from sales s where s.id = p_sale_id\\n$function$\\n\",\n        \"anular_abono(p_payment_id uuid)\": \"CREATE OR REPLACE FUNCTION public.anular_abono(p_payment_id uuid)\\n RETURNS void\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\ndeclare\\n  v_co uuid := public._ctx(array['admin', 'dueno']);\\n  p credit_payments%rowtype; v_cust text;\\nbegin\\n  select * into p from credit_payments where id = p_payment_id and company_id = v_co for update;\\n  if not found then raise exception 'Abono no existe'; end if;\\n  if p.status = 'anulado' then raise exception 'El abono ya está anulado'; end if;\\n  select name into v_cust from customers where id = p.customer_id;\\n\\n  update credit_payments set status = 'anulado' where id = p.id;\\n\\n  if p.method = 'efectivo' then\\n    insert into cash_entries (company_id, type, amount, description, reference_type, reference_id)\\n    values (v_co, 'egreso', p.amount, 'Anulación abono - ' || coalesce(v_cust, 'Cliente'), 'anulacion_abono', p.id);\\n  end if;\\n  perform public.acc_reverse_source(v_co, 'abono', p.id, 'anulación de abono');\\nend $function$\\n\",\n        \"cxc_save_account(p_account uuid)\": \"CREATE OR REPLACE FUNCTION public.cxc_save_account(p_account uuid)\\n RETURNS jsonb\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\ndeclare v_co uuid := public._ctx(array['admin', 'dueno']); v_res jsonb := null;\\nbegin\\n  if p_account is not null and not exists (\\n    select 1 from acc_accounts where id = p_account and company_id = v_co and is_postable and active\\n  ) then\\n    raise exception 'La cuenta elegida no existe, está inactiva o no admite movimientos';\\n  end if;\\n  insert into cxc_settings (company_id, account_id) values (v_co, p_account)\\n  on conflict (company_id) do update set account_id = excluded.account_id, updated_at = now();\\n  -- contabiliza lo que había quedado pendiente (ventas fiadas y abonos)\\n  if p_account is not null and exists (select 1 from acc_settings where company_id = v_co and active) then\\n    begin\\n      v_res := public.acc_post_pending();\\n    exception when others then\\n      v_res := null;\\n    end;\\n  end if;\\n  return coalesce(v_res, '{}'::jsonb);\\nend $function$\\n\",\n        \"anular_compra(p_purchase_id uuid)\": \"CREATE OR REPLACE FUNCTION public.anular_compra(p_purchase_id uuid)\\n RETURNS uuid\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\nDECLARE\\nv_co uuid;\\nv_purchase purchases%ROWTYPE;\\nv_item record;\\nv_prod products%ROWTYPE;\\nv_new numeric;\\nBEGIN\\n-- Solo administradores y dueños de empresa.\\nv_co := public._ctx(ARRAY['admin', 'dueno']);\\n\\n-- Bloquear la compra para evitar anulaciones simultáneas.\\nSELECT *\\nINTO v_purchase\\nFROM purchases\\nWHERE id = p_purchase_id\\nAND company_id = v_co\\nFOR UPDATE;\\n\\nIF NOT FOUND THEN\\nRAISE EXCEPTION 'La compra no existe o no tienes permiso para acceder a ella';\\nEND IF;\\n\\nIF v_purchase.status = 'anulada' THEN\\nRAISE EXCEPTION 'Esta compra ya fue anulada';\\nEND IF;\\n\\nIF v_purchase.status <> 'recibida' THEN\\nRAISE EXCEPTION 'Solo se pueden anular compras recibidas';\\nEND IF;\\n\\nIF v_purchase.items IS NULL\\nOR jsonb_typeof(v_purchase.items) <> 'array'\\nOR jsonb_array_length(v_purchase.items) = 0 THEN\\nRAISE EXCEPTION 'La compra no contiene artículos válidos';\\nEND IF;\\n\\n-- Lotes de esta compra: solo se puede anular si todavía están completos (no se ha vendido ni dado de baja nada)\\nIF EXISTS (SELECT 1 FROM product_lots WHERE company_id = v_co AND source_type = 'compra' AND source_id = v_purchase.id\\nAND qty_remaining < qty_initial) THEN\\nRAISE EXCEPTION 'No se puede anular: ya se vendió o dio de baja parte de los lotes de esta compra';\\nEND IF;\\nUPDATE product_lots SET qty_remaining = 0\\nWHERE company_id = v_co AND source_type = 'compra' AND source_id = v_purchase.id;\\n\\n-- Agrupar artículos repetidos y procesarlos en orden.\\nFOR v_item IN\\nSELECT\\n(item->>'product_id')::uuid AS product_id,\\nSUM((item->>'quantity')::numeric) AS quantity\\nFROM jsonb_array_elements(v_purchase.items) AS item\\nGROUP BY (item->>'product_id')::uuid\\nORDER BY (item->>'product_id')::uuid\\nLOOP\\nIF v_item.quantity <= 0 THEN\\nRAISE EXCEPTION 'La compra contiene una cantidad inválida';\\nEND IF;\\n\\nSELECT *\\nINTO v_prod\\nFROM products\\nWHERE id = v_item.product_id\\nAND company_id = v_co\\nFOR UPDATE;\\n\\nIF NOT FOUND THEN\\nRAISE EXCEPTION 'No se encontró un producto de esta compra';\\nEND IF;\\n\\nIF v_prod.stock < v_item.quantity THEN\\nRAISE EXCEPTION\\n'No se puede anular: el inventario actual de \\\"%\\\" es %, pero se necesitan % unidades para revertir la compra',\\nv_prod.name,\\nv_prod.stock,\\nv_item.quantity;\\nEND IF;\\n\\nv_new := v_prod.stock - v_item.quantity;\\n\\n-- Revertir las existencias.\\nUPDATE products\\nSET stock = v_new\\nWHERE id = v_prod.id\\nAND company_id = v_co;\\n\\n-- Registrar el movimiento compensatorio del kardex.\\nINSERT INTO kardex (\\ncompany_id,\\nproduct_id,\\nproduct_name,\\ntype,\\nquantity,\\nbalance,\\nreference_type,\\nreference_id,\\nnote\\n)\\nVALUES (\\nv_co,\\nv_prod.id,\\nv_prod.name,\\n'salida',\\nv_item.quantity,\\nv_new,\\n'purchase',\\nv_purchase.id,\\n'Anulación de compra'\\n);\\nEND LOOP;\\n\\n-- Compensar el egreso original de caja con un ingreso.\\nINSERT INTO cash_entries (\\ncompany_id,\\ntype,\\namount,\\ndescription,\\nreference_type,\\nreference_id\\n)\\nVALUES (\\nv_co,\\n'ingreso',\\nv_purchase.total,\\n'Reversión por anulación de compra - '\\n|| COALESCE(v_purchase.supplier_name, 'Proveedor general'),\\n'purchase',\\nv_purchase.id\\n);\\n\\n-- Conservar la compra original y marcarla como anulada.\\nUPDATE purchases\\nSET status = 'anulada'\\nWHERE id = v_purchase.id\\nAND company_id = v_co;\\n\\nRETURN v_purchase.id;\\nEND;\\n$function$\\n\",\n        \"acc_post_payment(p_payment_id uuid)\": \"CREATE OR REPLACE FUNCTION public.acc_post_payment(p_payment_id uuid)\\n RETURNS uuid\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO ''\\nAS $function$\\ndeclare\\n  p public.credit_payments; s public.acc_settings; v_date date;\\n  v_cxc uuid; v_pay uuid; v_other uuid; v_in numeric := 0; v_out numeric := 0; v_lines jsonb;\\nbegin\\n  select * into p from public.credit_payments where id = p_payment_id;\\n  if not found or p.status <> 'activo' then return null; end if;\\n  select * into s from public.acc_settings where company_id = p.company_id;\\n  if not found or not s.active or s.start_date is null then return null; end if;\\n  v_date := (p.created_at at time zone s.timezone)::date;\\n  if v_date < s.start_date then return null; end if;\\n\\n  select account_id into v_cxc from public.cxc_settings where company_id = p.company_id;\\n  v_pay := case when p.method = 'efectivo' then (s.map->>'caja')::uuid else (s.map->>'bancos')::uuid end;\\n  v_other := (s.map->>'otros_ingresos')::uuid;\\n  if v_cxc is null or v_pay is null then return null; end if;\\n\\n  -- lo aplicado a ventas anteriores al inicio contable no tiene cuenta por cobrar contabilizada\\n  select coalesce(sum(a.amount) filter (where (sl.created_at at time zone s.timezone)::date >= s.start_date), 0),\\n         coalesce(sum(a.amount) filter (where (sl.created_at at time zone s.timezone)::date <  s.start_date), 0)\\n    into v_in, v_out\\n  from public.credit_allocations a join public.sales sl on sl.id = a.sale_id\\n  where a.payment_id = p.id;\\n  if v_out > 0 and v_other is null then return null; end if;\\n\\n  v_lines := jsonb_build_array(jsonb_build_object('account_id', v_pay, 'debit', p.amount,\\n                'memo', 'Abono de cliente (' || p.method || ')'));\\n  if v_in > 0 then\\n    v_lines := v_lines || jsonb_build_array(jsonb_build_object('account_id', v_cxc, 'credit', v_in));\\n  end if;\\n  if v_out > 0 then\\n    v_lines := v_lines || jsonb_build_array(jsonb_build_object('account_id', v_other, 'credit', v_out,\\n                  'memo', 'Cobro de ventas anteriores al inicio contable'));\\n  end if;\\n  if jsonb_array_length(v_lines) < 2 then return null; end if;\\n\\n  return public.acc_system_entry(p.company_id, v_date,\\n    'Abono de cliente' || coalesce(': ' || (select name from public.customers where id = p.customer_id), ''),\\n    'abono', p.id, 'registro', 'A-' || substr(p.id::text, 1, 8), v_lines);\\nend $function$\\n\",\n        \"_customer_owed(p_co uuid, p_customer uuid)\": \"CREATE OR REPLACE FUNCTION public._customer_owed(p_co uuid, p_customer uuid)\\n RETURNS numeric\\n LANGUAGE sql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n  select coalesce(sum(public._sale_balance(s.id)), 0)\\n  from sales s\\n  where s.company_id = p_co and s.customer_id = p_customer\\n    and s.payment_method = 'fiado' and s.status = 'completada'\\n$function$\\n\",\n        \"registrar_compra(p_supplier_id uuid, p_items jsonb)\": \"CREATE OR REPLACE FUNCTION public.registrar_compra(p_supplier_id uuid, p_items jsonb)\\n RETURNS uuid\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\ndeclare\\nv_co uuid := public._ctx(array['admin', 'dueno']);\\ne jsonb; v_prod products%rowtype; v_pid uuid;\\nv_qty numeric; v_cost numeric; v_total numeric := 0;\\nv_sup text; v_exp date; v_lot text; v_id uuid; v_items jsonb := '[]'::jsonb; v_new numeric;\\nbegin\\nif p_items is null or jsonb_typeof(p_items) <> 'array' or jsonb_array_length(p_items) = 0 then\\nraise exception 'La compra no tiene items';\\nend if;\\nif p_supplier_id is not null then\\nselect name into v_sup from suppliers where id = p_supplier_id and company_id = v_co;\\nif not found then raise exception 'Proveedor no existe'; end if;\\nend if;\\n\\ninsert into purchases (company_id, supplier_id, supplier_name, items, total, status)\\nvalues (v_co, p_supplier_id, v_sup, '[]', 0, 'recibida')\\nreturning id into v_id;\\n\\nfor e in select x from jsonb_array_elements(p_items) x order by x->>'product_id' loop\\nv_pid  := _item_uuid(e, 'product_id');\\nv_qty  := _item_num(e, 'quantity');\\nv_cost := _item_num(e, 'cost');\\nif v_qty <= 0 or v_cost < 0 then raise exception 'Cantidad o costo inválido'; end if;\\n\\nselect * into v_prod from products where id = v_pid and company_id = v_co for update;\\nif not found then raise exception 'Producto no existe'; end if;\\n\\nv_new := v_prod.stock + v_qty;\\nupdate products set stock = v_new, cost = v_cost where id = v_prod.id;\\n\\ninsert into kardex (company_id, product_id, product_name, type, quantity, balance, reference_type, reference_id)\\nvalues (v_co, v_prod.id, v_prod.name, 'entrada', v_qty, v_new, 'purchase', v_id);\\n\\n-- Productos con vencimiento: cada compra crea su lote\\nv_exp := null; v_lot := null;\\nif v_prod.tracks_expiry then\\nif coalesce(e->>'expiry_date', '') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' then\\nraise exception 'El producto \\\"%\\\" maneja vencimiento: indica la fecha de vencimiento del lote', v_prod.name;\\nend if;\\nv_exp := (e->>'expiry_date')::date;\\nif v_exp < public._co_today(v_co) then raise exception 'La fecha de vencimiento de \\\"%\\\" ya pasó', v_prod.name; end if;\\nif v_exp > date '2100-01-01' then raise exception 'Fecha de vencimiento inválida para \\\"%\\\"', v_prod.name; end if;\\nv_lot := coalesce(nullif(left(btrim(coalesce(e->>'lot_code', '')), 40), ''), 'S/L');\\ninsert into product_lots (company_id, product_id, lot_code, expiry_date, qty_initial, qty_remaining, cost, source_type, source_id)\\nvalues (v_co, v_prod.id, v_lot, v_exp, v_qty, v_qty, v_cost, 'compra', v_id);\\nend if;\\n\\nv_total := v_total + v_qty * v_cost;\\nv_items := v_items || (jsonb_build_object(\\n'product_id', v_prod.id, 'product_name', v_prod.name,\\n'quantity', v_qty, 'cost', v_cost, 'subtotal', v_qty * v_cost)\\n|| case when v_exp is not null then jsonb_build_object('lot_code', v_lot, 'expiry_date', v_exp) else '{}'::jsonb end);\\nend loop;\\n\\nupdate purchases set items = v_items, total = v_total where id = v_id;\\n\\ninsert into cash_entries (company_id, type, amount, description, reference_type, reference_id)\\nvalues (v_co, 'egreso', v_total, 'Compra - ' || coalesce(v_sup, 'Proveedor general'), 'purchase', v_id);\\nreturn v_id;\\nend $function$\\n\",\n        \"acc_post_purchase(p_p purchases, p_estimated boolean)\": \"CREATE OR REPLACE FUNCTION public.acc_post_purchase(p_p purchases, p_estimated boolean DEFAULT false)\\n RETURNS uuid\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO ''\\nAS $function$\\ndeclare s public.acc_settings; v_date date;\\nbegin\\n  select * into s from public.acc_settings where company_id = p_p.company_id;\\n  if not found or not s.active or s.start_date is null then return null; end if;\\n  v_date := (p_p.created_at at time zone s.timezone)::date;\\n  if v_date < s.start_date or p_p.total <= 0 then return null; end if;\\n  return public.acc_system_entry(\\n    p_p.company_id, v_date,\\n    'Compra a ' || coalesce(p_p.supplier_name, 'Proveedor general') ||\\n      case when p_estimated then ' (registrada con retraso)' else '' end,\\n    'compra', p_p.id, 'registro', 'C-' || substr(p_p.id::text, 1, 8),\\n    jsonb_build_array(\\n      jsonb_build_object('account_id', (s.map->>'inventario')::uuid, 'debit', p_p.total),\\n      jsonb_build_object('account_id', (s.map->>'caja')::uuid, 'credit', p_p.total, 'memo', 'Pago de compra')));\\nend $function$\\n\"\n    },\n    \"politicas\": [\n        {\n            \"cmd\": \"SELECT\",\n            \"qual\": \"(company_id = current_company_id())\",\n            \"tabla\": \"credit_allocations\",\n            \"nombre\": \"credit_allocations_select\",\n            \"with_check\": null\n        },\n        {\n            \"cmd\": \"SELECT\",\n            \"qual\": \"(company_id = current_company_id())\",\n            \"tabla\": \"credit_payments\",\n            \"nombre\": \"credit_payments_select\",\n            \"with_check\": null\n        },\n        {\n            \"cmd\": \"SELECT\",\n            \"qual\": \"(company_id = current_company_id())\",\n            \"tabla\": \"customer_credit\",\n            \"nombre\": \"customer_credit_select\",\n            \"with_check\": null\n        },\n        {\n            \"cmd\": \"SELECT\",\n            \"qual\": \"(company_id = current_company_id())\",\n            \"tabla\": \"purchases\",\n            \"nombre\": \"purchases_select\",\n            \"with_check\": null\n        },\n        {\n            \"cmd\": \"SELECT\",\n            \"qual\": \"(company_id = current_company_id())\",\n            \"tabla\": \"suppliers\",\n            \"nombre\": \"suppliers_select\",\n            \"with_check\": null\n        },\n        {\n            \"cmd\": \"ALL\",\n            \"qual\": \"((company_id = current_company_id()) AND (_my_role() = ANY (ARRAY['admin'::text, 'dueno'::text])))\",\n            \"tabla\": \"suppliers\",\n            \"nombre\": \"suppliers_write\",\n            \"with_check\": \"((company_id = current_company_id()) AND (_my_role() = ANY (ARRAY['admin'::text, 'dueno'::text])))\"\n        }\n    ],\n    \"triggers_purchases\": [\n        {\n            \"funcion\": \"audit_row\",\n            \"trigger\": \"credit_payments_audit\",\n            \"definicion\": \"CREATE TRIGGER credit_payments_audit AFTER INSERT OR DELETE OR UPDATE ON public.credit_payments FOR EACH ROW EXECUTE FUNCTION audit_row()\",\n            \"codigo_funcion\": \"CREATE OR REPLACE FUNCTION public.audit_row()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n                                            declare\\n                                              v_old jsonb; v_new jsonb; v_row jsonb; v_detail jsonb; v_name text;\\n                                              begin\\n                                                if tg_op = 'DELETE' then\\n                                                    v_row := to_jsonb(old);  v_detail := jsonb_build_object('registro', v_row);\\n                                                      elsif tg_op = 'INSERT' then\\n                                                          v_row := to_jsonb(new);  v_detail := jsonb_build_object('registro', v_row);\\n                                                            else\\n                                                                v_old := to_jsonb(old);  v_new := to_jsonb(new);  v_row := v_new;\\n                                                                    select jsonb_object_agg(n.key, jsonb_build_object('antes', o.value, 'despues', n.value))\\n                                                                          into v_detail\\n                                                                                from jsonb_each(v_new) n join jsonb_each(v_old) o on o.key = n.key\\n                                                                                     where o.value is distinct from n.value;\\n                                                                                         if v_detail is null then return null; end if;   -- sin cambios reales\\n                                                                                           end if;\\n\\n                                                                                             select full_name into v_name from profiles where id = auth.uid();\\n\\n                                                                                               insert into audit_log (company_id, user_id, user_name, action, table_name, record_id, detail)\\n                                                                                                 values ((v_row->>'company_id')::uuid, auth.uid(), v_name, tg_op, tg_table_name,\\n                                                                                                           (v_row->>'id')::uuid, v_detail);\\n                                                                                                             return null;\\n                                                                                                             end $function$\\n\"\n        },\n        {\n            \"funcion\": \"assert_can_write\",\n            \"trigger\": \"credit_payments_check_subscription\",\n            \"definicion\": \"CREATE TRIGGER credit_payments_check_subscription BEFORE INSERT OR DELETE OR UPDATE ON public.credit_payments FOR EACH ROW EXECUTE FUNCTION assert_can_write()\",\n            \"codigo_funcion\": \"CREATE OR REPLACE FUNCTION public.assert_can_write()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n                                                                         begin\\n                                                                           perform public._assert_write_allowed();\\n                                                                             if tg_op = 'DELETE' then return old; end if;\\n                                                                               return new;\\n                                                                               end $function$\\n\"\n        },\n        {\n            \"funcion\": \"acc_trg_purchases\",\n            \"trigger\": \"acc_purchases_after_update\",\n            \"definicion\": \"CREATE TRIGGER acc_purchases_after_update AFTER UPDATE ON public.purchases FOR EACH ROW EXECUTE FUNCTION acc_trg_purchases()\",\n            \"codigo_funcion\": \"CREATE OR REPLACE FUNCTION public.acc_trg_purchases()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO ''\\nAS $function$\\nbegin\\n  if not exists (select 1 from public.acc_settings where company_id = new.company_id and active) then\\n    return new;\\n  end if;\\n  if jsonb_array_length(old.items) = 0 and jsonb_array_length(new.items) > 0 and new.status = 'recibida' then\\n    perform public.acc_post_purchase(new);\\n  elsif old.status <> 'anulada' and new.status = 'anulada' then\\n    perform public.acc_reverse_source(new.company_id, 'compra', new.id, 'anulación de compra');\\n  end if;\\n  return new;\\nend $function$\\n\"\n        },\n        {\n            \"funcion\": \"audit_row\",\n            \"trigger\": \"purchases_audit\",\n            \"definicion\": \"CREATE TRIGGER purchases_audit AFTER INSERT OR DELETE OR UPDATE ON public.purchases FOR EACH ROW EXECUTE FUNCTION audit_row()\",\n            \"codigo_funcion\": \"CREATE OR REPLACE FUNCTION public.audit_row()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n                                            declare\\n                                              v_old jsonb; v_new jsonb; v_row jsonb; v_detail jsonb; v_name text;\\n                                              begin\\n                                                if tg_op = 'DELETE' then\\n                                                    v_row := to_jsonb(old);  v_detail := jsonb_build_object('registro', v_row);\\n                                                      elsif tg_op = 'INSERT' then\\n                                                          v_row := to_jsonb(new);  v_detail := jsonb_build_object('registro', v_row);\\n                                                            else\\n                                                                v_old := to_jsonb(old);  v_new := to_jsonb(new);  v_row := v_new;\\n                                                                    select jsonb_object_agg(n.key, jsonb_build_object('antes', o.value, 'despues', n.value))\\n                                                                          into v_detail\\n                                                                                from jsonb_each(v_new) n join jsonb_each(v_old) o on o.key = n.key\\n                                                                                     where o.value is distinct from n.value;\\n                                                                                         if v_detail is null then return null; end if;   -- sin cambios reales\\n                                                                                           end if;\\n\\n                                                                                             select full_name into v_name from profiles where id = auth.uid();\\n\\n                                                                                               insert into audit_log (company_id, user_id, user_name, action, table_name, record_id, detail)\\n                                                                                                 values ((v_row->>'company_id')::uuid, auth.uid(), v_name, tg_op, tg_table_name,\\n                                                                                                           (v_row->>'id')::uuid, v_detail);\\n                                                                                                             return null;\\n                                                                                                             end $function$\\n\"\n        },\n        {\n            \"funcion\": \"assert_can_write\",\n            \"trigger\": \"purchases_check_subscription\",\n            \"definicion\": \"CREATE TRIGGER purchases_check_subscription BEFORE INSERT OR DELETE OR UPDATE ON public.purchases FOR EACH ROW EXECUTE FUNCTION assert_can_write()\",\n            \"codigo_funcion\": \"CREATE OR REPLACE FUNCTION public.assert_can_write()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'pg_catalog', 'public', 'pg_temp'\\nAS $function$\\n                                                                         begin\\n                                                                           perform public._assert_write_allowed();\\n                                                                             if tg_op = 'DELETE' then return old; end if;\\n                                                                               return new;\\n                                                                               end $function$\\n\"\n        }\n    ]\n}"
