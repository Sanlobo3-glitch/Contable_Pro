  -- Productos de prueba
  v_prod_track uuid;
  v_prod_notrack uuid;
  v_prod_notrack_dev uuid;
  v_prod_notrack_seq uuid;
  v_prod_hist1 uuid; v_prod_hist2 uuid; v_prod_hist3 uuid; v_prod_hist4 uuid;

  -- Cuentas
  v_acc_desc uuid;
  v_acc_pend uuid;
  v_acc_pasivo uuid;
  v_acc_inactiva uuid;
  v_acc_noimp uuid;

  -- Baseline de conciliación (no presupone ceros históricos)
  v_base_op jsonb := '{}'::jsonb;
  v_base_acc jsonb := '{}'::jsonb;
  v_base_diff jsonb := '{}'::jsonb;
  v_rec record;
  v_seen_cats text[];
  v_req_cats text[] := array[
    'ventas', 'ventas_pendientes', 'compras', 'compras_reclasificacion_inv',
    'devoluciones_compra_inv', 'iva_compras_costo_gasto',
    'iva_compras_descontable', 'iva_compras_pendiente', 'inventario', 'caja'
  ];

  -- Identificadores de casos
  v_p1 uuid; v_p2 uuid; v_p3 uuid; v_p4 uuid; v_p5 uuid;
  v_p_pre_old uuid; v_s_pre uuid; v_p_post_seq uuid; v_p_new_adj uuid;
  v_p_hist_sale uuid; v_s_hist uuid;
  v_p_hist_pur uuid; v_p_hist_pur2 uuid;
  v_p_hist_adj uuid; v_p_hist_mig uuid; v_dev_hist uuid;
  v_seq1 bigint; v_seq2 bigint; v_seq3 bigint;
  v_p_dev_nl uuid; v_dev_nl uuid;
  v_p_dev_nl_blk uuid; v_dev_nl_blk uuid;
  v_p_dev_lote uuid; v_dev_lote uuid;
  v_lot_a uuid; v_lot_b uuid; v_lot_a_rem numeric; v_lot_b_rem numeric;

  -- Form 300 (6 casos en 2098-01..03 y 2098-03..05)
  v_f_t1_start timestamptz := '2098-01-01 00:00:00+00';
  v_f_t1_end   timestamptz := '2098-03-01 00:00:00+00';
  v_f_t2_start timestamptz := '2098-03-01 00:00:00+00';
  v_f_t2_end   timestamptz := '2098-05-01 00:00:00+00';
  v_f_a uuid; v_f_b uuid; v_f_c uuid; v_f_d uuid; v_f_e uuid; v_f_f uuid; v_f_pend uuid;
  v_dev_d uuid; v_dev_e uuid;
  v_adj_c uuid; v_adj_d uuid; v_adj_e uuid; v_adj_f uuid;
  v_f300_p1 jsonb; v_f300_p2 jsonb;

  -- Frontera s.start_date en acc_reconcile()
  v_start_orig date;
  v_p_before_start uuid;
  v_dev_after_start uuid;

  -- Conteo no duplicidad / cero cambios parciales
  v_cnt_before int; v_k_cnt_b int; v_acc_e_b int; v_acc_l_b int; v_dev_cnt_b int;
  v_stock_before numeric; v_cost_before numeric;
  v_cnt_orig int; v_cnt_rev int; v_cnt_activos int; v_orig_entry_id uuid;
  v_other_pur uuid; v_other_lot uuid; v_other_adj uuid; v_other_dev uuid;
BEGIN
  -- 0. Preparar actores y cuentas reales
  SELECT id INTO v_uid_dueno FROM public.profiles WHERE company_id = v_co AND active = true ORDER BY created_at LIMIT 1;
  UPDATE public.profiles SET role = 'dueno' WHERE id = v_uid_dueno;

  -- Buscar un usuario gerente/admin_empresa distinto del administrador de plataforma
  SELECT id INTO v_uid_admin_emp FROM public.profiles
  WHERE company_id = v_co AND active = true AND id <> v_uid_dueno
    AND lower(btrim(coalesce(email, ''))) <> 'sanlobo3@hotmail.com'
  LIMIT 1;
  IF v_uid_admin_emp IS NULL THEN
    v_uid_admin_emp := v_uid_dueno;
  END IF;

  -- Identificar usuario que REALMENTE cumpla is_platform_admin()
  SELECT p.id INTO v_uid_plat_admin
  FROM public.profiles p
  LEFT JOIN public.platform_admins pa ON pa.user_id = p.id AND pa.active = true
  WHERE p.active = true
    AND (lower(btrim(coalesce(p.email, ''))) = 'sanlobo3@hotmail.com' OR pa.user_id IS NOT NULL)
  LIMIT 1;
  IF v_uid_plat_admin IS NULL THEN
    INSERT INTO public.platform_admins (user_id, email, active)
    SELECT p.id, p.email, true FROM public.profiles p WHERE p.id = v_uid_dueno
    ON CONFLICT (user_id) DO UPDATE SET active = true;
    v_uid_plat_admin := v_uid_dueno;
  END IF;

  SELECT id INTO v_other_co FROM public.companies WHERE id <> v_co LIMIT 1;
  SELECT id INTO v_uid_other FROM public.profiles WHERE company_id = v_other_co AND active = true LIMIT 1;
  IF v_other_co IS NULL OR v_uid_other IS NULL THEN
    RAISE EXCEPTION 'Se requiere segunda empresa con perfil activo para prueba multiempresa';
  END IF;

  -- Activar sesión de dueño para configurar y capturar línea base de conciliación
  PERFORM set_config('request.jwt.claim.sub', v_uid_dueno::text, true);
  SELECT id INTO v_acc_desc FROM public.acc_accounts WHERE company_id = v_co AND code = '1.1.05';
  SELECT id INTO v_acc_pend FROM public.acc_accounts WHERE company_id = v_co AND code = '1.1.06';
  SELECT id INTO v_acc_pasivo FROM public.acc_accounts WHERE company_id = v_co AND code = '2.1.02';
  SELECT id INTO v_acc_noimp FROM public.acc_accounts WHERE company_id = v_co AND is_postable = false LIMIT 1;
  INSERT INTO public.acc_accounts (company_id, code, name, type, nature, is_postable, active)
  VALUES (v_co, '1.1.99', 'IVA Inactiva Audit', 'activo', 'debito', true, false) RETURNING id INTO v_acc_inactiva;

  -- 1. Validar rechazo sin cuenta IVA (cero cambios parciales) y luego configurar cuentas válidas
  PERFORM public.acc_save_settings(jsonb_build_object('iva_descontable', '', 'iva_pendiente', ''));
  INSERT INTO public.suppliers (company_id, name, document) VALUES (v_co, 'Prov Audit 4', '900888777') RETURNING id INTO v_sup;
  INSERT INTO public.products (company_id, name, price, cost, stock, tracks_expiry)
  VALUES (v_co, 'SKU Guard', 300, 0, 0, false) RETURNING id INTO v_prod_notrack;

  SELECT count(*) INTO v_cnt_before FROM public.purchases WHERE company_id = v_co;
  BEGIN
    PERFORM public.registrar_compra(
      v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_notrack, 'quantity', 5, 'cost', 100)),
      'efectivo', null, 95, 'descontable', 19, false
    );
    RAISE EXCEPTION 'FAIL #1a: permitió descontable sin cuenta configurada';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%Falta configurar la cuenta contable "iva_descontable"%' THEN RAISE; END IF;
  END;
  PERFORM 1 FROM public.products WHERE id = v_prod_notrack AND stock = 0 AND cost = 0;
  IF NOT FOUND OR (SELECT count(*) FROM public.purchases WHERE company_id = v_co) <> v_cnt_before THEN
    RAISE EXCEPTION 'FAIL #1b: dejó cambios parciales tras rechazo de cuenta IVA';
  END IF;

  BEGIN
    PERFORM public.acc_save_settings(jsonb_build_object('iva_descontable', v_acc_pasivo::text));
    RAISE EXCEPTION 'FAIL #1c: aceptó cuenta pasivo';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%tipo activo y naturaleza debito%' THEN RAISE; END IF;
  END;
  PERFORM public.acc_save_settings(jsonb_build_object('iva_descontable', v_acc_desc::text, 'iva_pendiente', v_acc_pend::text));

  -- ==========================================================================
  -- PRUEBAS DE SECUENCIA HISTÓRICA vs NUEVA EN KARDEX (SIN CAMBIOS PARCIALES)
  -- Se ejecutan ANTES de capturar la línea base de acc_reconcile()
  -- ==========================================================================

  -- H1. Compra histórica con venta posterior y seq invertido por heap scan (seq_verified = false)
  INSERT INTO public.products (company_id, name, price, cost, stock, tracks_expiry)
  VALUES (v_co, 'SKU Hist Sale', 300, 0, 0, false) RETURNING id INTO v_prod_hist1;
  v_p_hist_sale := public.registrar_compra(v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_hist1, 'quantity', 10, 'cost', 100)), 'efectivo', null, 190, 'pendiente', 19, false);
  v_s_hist := public.registrar_venta(null, jsonb_build_array(jsonb_build_object('product_id', v_prod_hist1, 'quantity', 3, 'price', 250)), 'efectivo');
  UPDATE public.kardex SET seq_verified = false, seq = 9001 WHERE product_id = v_prod_hist1 AND reference_id = v_p_hist_sale;
  UPDATE public.kardex SET seq_verified = false, seq = 1001 WHERE product_id = v_prod_hist1 AND reference_id = v_s_hist;

  SELECT stock, cost INTO v_stock_before, v_cost_before FROM public.products WHERE id = v_prod_hist1;
  SELECT count(*) INTO v_k_cnt_b FROM public.kardex WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_e_b FROM public.acc_entries WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_l_b FROM public.acc_lines WHERE company_id = v_co;

  BEGIN
    PERFORM public.clasificar_iva_compra(v_p_hist_sale, 'costo', 'Hist sale');
    RAISE EXCEPTION 'FAIL-H1a: permitió reclasificar al costo compra histórica con venta posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%Compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.anular_compra(v_p_hist_sale);
    RAISE EXCEPTION 'FAIL-H1b: permitió anular compra histórica con venta posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.registrar_devolucion_compra(v_p_hist_sale, v_prod_hist1, 1, 'Hist sale dev', 'efectivo');
    RAISE EXCEPTION 'FAIL-H1c: permitió devolver compra histórica con venta posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  IF (SELECT stock FROM public.products WHERE id = v_prod_hist1) <> v_stock_before
     OR (SELECT cost FROM public.products WHERE id = v_prod_hist1) <> v_cost_before
     OR (SELECT count(*) FROM public.kardex WHERE company_id = v_co) <> v_k_cnt_b
     OR (SELECT count(*) FROM public.acc_entries WHERE company_id = v_co) <> v_acc_e_b
     OR (SELECT count(*) FROM public.acc_lines WHERE company_id = v_co) <> v_acc_l_b THEN
    RAISE EXCEPTION 'FAIL-H1-atom: dejó cambios parciales tras bloqueo histórico H1';
  END IF;

  -- H2. Compra histórica con segunda compra posterior y seq invertido (seq_verified = false)
  INSERT INTO public.products (company_id, name, price, cost, stock, tracks_expiry)
  VALUES (v_co, 'SKU Hist Pur', 300, 0, 0, false) RETURNING id INTO v_prod_hist2;
  v_p_hist_pur := public.registrar_compra(v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_hist2, 'quantity', 5, 'cost', 100)), 'efectivo', null, 95, 'pendiente', 19, false);
  v_p_hist_pur2 := public.registrar_compra(v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_hist2, 'quantity', 5, 'cost', 200)), 'efectivo', null, 0, 'sin_iva', 0, false);
  UPDATE public.kardex SET seq_verified = false, seq = 9002 WHERE product_id = v_prod_hist2 AND reference_id = v_p_hist_pur;
  UPDATE public.kardex SET seq_verified = false, seq = 1002 WHERE product_id = v_prod_hist2 AND reference_id = v_p_hist_pur2;

  SELECT stock, cost INTO v_stock_before, v_cost_before FROM public.products WHERE id = v_prod_hist2;
  SELECT count(*) INTO v_k_cnt_b FROM public.kardex WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_e_b FROM public.acc_entries WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_l_b FROM public.acc_lines WHERE company_id = v_co;

  BEGIN
    PERFORM public.clasificar_iva_compra(v_p_hist_pur, 'costo', 'Hist pur');
    RAISE EXCEPTION 'FAIL-H2a: permitió reclasificar compra histórica con recompra posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%Compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.anular_compra(v_p_hist_pur);
    RAISE EXCEPTION 'FAIL-H2b: permitió anular compra histórica con recompra posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.registrar_devolucion_compra(v_p_hist_pur, v_prod_hist2, 1, 'Hist pur dev', 'efectivo');
    RAISE EXCEPTION 'FAIL-H2c: permitió devolver compra histórica con recompra posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  IF (SELECT stock FROM public.products WHERE id = v_prod_hist2) <> v_stock_before
     OR (SELECT cost FROM public.products WHERE id = v_prod_hist2) <> v_cost_before
     OR (SELECT count(*) FROM public.kardex WHERE company_id = v_co) <> v_k_cnt_b
     OR (SELECT count(*) FROM public.acc_entries WHERE company_id = v_co) <> v_acc_e_b
     OR (SELECT count(*) FROM public.acc_lines WHERE company_id = v_co) <> v_acc_l_b THEN
    RAISE EXCEPTION 'FAIL-H2-atom: dejó cambios parciales tras bloqueo histórico H2';
  END IF;

  -- H3. Compra histórica con ajuste de stock posterior (ajustar_stock, seq_verified = false)
  INSERT INTO public.products (company_id, name, price, cost, stock, tracks_expiry)
  VALUES (v_co, 'SKU Hist Adj', 300, 0, 0, false) RETURNING id INTO v_prod_hist3;
  v_p_hist_adj := public.registrar_compra(v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_hist3, 'quantity', 5, 'cost', 100)), 'efectivo', null, 95, 'pendiente', 19, false);
  PERFORM public.ajustar_stock(v_prod_hist3, 8, 'Ajuste histórico posterior');
  UPDATE public.kardex SET seq_verified = false, seq = 9003 WHERE product_id = v_prod_hist3 AND reference_id = v_p_hist_adj;
  UPDATE public.kardex SET seq_verified = false, seq = 1003 WHERE product_id = v_prod_hist3 AND reference_type = 'ajuste';

  SELECT stock, cost INTO v_stock_before, v_cost_before FROM public.products WHERE id = v_prod_hist3;
  SELECT count(*) INTO v_k_cnt_b FROM public.kardex WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_e_b FROM public.acc_entries WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_l_b FROM public.acc_lines WHERE company_id = v_co;

  BEGIN
    PERFORM public.clasificar_iva_compra(v_p_hist_adj, 'costo', 'Hist adj');
    RAISE EXCEPTION 'FAIL-H3a: permitió reclasificar compra histórica con ajuste posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%Compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.anular_compra(v_p_hist_adj);
    RAISE EXCEPTION 'FAIL-H3b: permitió anular compra histórica con ajuste posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.registrar_devolucion_compra(v_p_hist_adj, v_prod_hist3, 1, 'Hist adj dev', 'efectivo');
    RAISE EXCEPTION 'FAIL-H3c: permitió devolver compra histórica con ajuste posterior';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  IF (SELECT stock FROM public.products WHERE id = v_prod_hist3) <> v_stock_before
     OR (SELECT cost FROM public.products WHERE id = v_prod_hist3) <> v_cost_before
     OR (SELECT count(*) FROM public.kardex WHERE company_id = v_co) <> v_k_cnt_b
     OR (SELECT count(*) FROM public.acc_entries WHERE company_id = v_co) <> v_acc_e_b
     OR (SELECT count(*) FROM public.acc_lines WHERE company_id = v_co) <> v_acc_l_b THEN
    RAISE EXCEPTION 'FAIL-H3-atom: dejó cambios parciales tras bloqueo histórico H3';
  END IF;

  -- H4. Compra histórica sin movimientos visibles, pero con seq asignado en migración (seq_verified = false)
  INSERT INTO public.products (company_id, name, price, cost, stock, tracks_expiry)
  VALUES (v_co, 'SKU Hist Mig', 300, 0, 0, false) RETURNING id INTO v_prod_hist4;
  v_p_hist_mig := public.registrar_compra(v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_hist4, 'quantity', 5, 'cost', 100)), 'efectivo', null, 95, 'pendiente', 19, false);
  UPDATE public.kardex SET seq_verified = false, seq = 9004 WHERE product_id = v_prod_hist4 AND reference_id = v_p_hist_mig;

  BEGIN
    UPDATE public.kardex SET seq_verified = true WHERE product_id = v_prod_hist4 AND reference_id = v_p_hist_mig;
    RAISE EXCEPTION 'FAIL-H4-trg: trigger permitió promover seq_verified de false a true';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%No se permite marcar como verificable%' THEN RAISE; END IF;
  END;

  SELECT stock, cost INTO v_stock_before, v_cost_before FROM public.products WHERE id = v_prod_hist4;
  SELECT count(*) INTO v_k_cnt_b FROM public.kardex WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_e_b FROM public.acc_entries WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_l_b FROM public.acc_lines WHERE company_id = v_co;

  BEGIN
    PERFORM public.clasificar_iva_compra(v_p_hist_mig, 'costo', 'Hist mig');
    RAISE EXCEPTION 'FAIL-H4a: permitió reclasificar al costo compra histórica con seq no verificable';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%Compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.anular_compra(v_p_hist_mig);
    RAISE EXCEPTION 'FAIL-H4b: permitió anular compra histórica con seq no verificable';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.registrar_devolucion_compra(v_p_hist_mig, v_prod_hist4, 1, 'Hist mig dev', 'efectivo');
    RAISE EXCEPTION 'FAIL-H4c: permitió devolver compra histórica con seq no verificable';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%compra histórica o sin secuencia verificable%' THEN RAISE; END IF;
  END;
  IF (SELECT stock FROM public.products WHERE id = v_prod_hist4) <> v_stock_before
     OR (SELECT cost FROM public.products WHERE id = v_prod_hist4) <> v_cost_before
     OR (SELECT count(*) FROM public.kardex WHERE company_id = v_co) <> v_k_cnt_b
     OR (SELECT count(*) FROM public.acc_entries WHERE company_id = v_co) <> v_acc_e_b
     OR (SELECT count(*) FROM public.acc_lines WHERE company_id = v_co) <> v_acc_l_b THEN
    RAISE EXCEPTION 'FAIL-H4-atom: dejó cambios parciales tras bloqueo histórico H4';
  END IF;

  -- N1. Compra1 -> Venta1 -> Compra2 en UNA SOLA transacción (mismo created_at = now())
  INSERT INTO public.products (company_id, name, price, cost, stock, tracks_expiry)
  VALUES (v_co, 'SKU Seq Intratx', 300, 0, 0, false) RETURNING id INTO v_prod_notrack_seq;

  v_p_pre_old := public.registrar_compra(
    v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_notrack_seq, 'quantity', 5, 'cost', 100)),
    'efectivo', null, 0, 'sin_iva', 0, false
  );
  v_s_pre := public.registrar_venta(null, jsonb_build_array(jsonb_build_object('product_id', v_prod_notrack_seq, 'quantity', 5, 'price', 250)), 'efectivo');
  v_p_post_seq := public.registrar_compra(
    v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_notrack_seq, 'quantity', 10, 'cost', 100)),
    'efectivo', null, 190, 'pendiente', 19, false
  );

  SELECT seq INTO v_seq1 FROM public.kardex WHERE product_id = v_prod_notrack_seq AND reference_id = v_p_pre_old AND seq_verified = true;
  SELECT seq INTO v_seq2 FROM public.kardex WHERE product_id = v_prod_notrack_seq AND reference_id = v_s_pre AND seq_verified = true;
  SELECT seq INTO v_seq3 FROM public.kardex WHERE product_id = v_prod_notrack_seq AND reference_id = v_p_post_seq AND seq_verified = true;
  IF v_seq1 IS NULL OR v_seq2 IS NULL OR v_seq3 IS NULL OR NOT (v_seq1 < v_seq2 AND v_seq2 < v_seq3) THEN
    RAISE EXCEPTION 'FAIL-N1-seq: secuencia intratransaccional no monotónica (%, %, %)', v_seq1, v_seq2, v_seq3;
  END IF;

  -- P2 (posterior a S1 en misma tx) debe reclasificar a 'costo' y anularse limpiamente; P1 (con S1 posterior) debe bloquearse
  PERFORM public.clasificar_iva_compra(v_p_post_seq, 'costo', 'Misma tx sin falsos bloqueos');
  PERFORM 1 FROM public.purchases WHERE id = v_p_post_seq AND iva_cost_inventory = 190 AND iva_cost_expense = 0;
  IF NOT FOUND THEN RAISE EXCEPTION 'FAIL-N1-reclass: no reclasificó P2 posterior a S1'; END IF;
  PERFORM public.anular_compra(v_p_post_seq);

  BEGIN
    PERFORM public.anular_compra(v_p_pre_old);
    RAISE EXCEPTION 'FAIL-N1-blk: permitió anular P1 pese a S1 y P2 posteriores';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%existen ventas, ajustes o recompras posteriores%' THEN RAISE; END IF;
  END;

  -- N3. Compra nueva seguida de ajuste de stock positivo (ajustar_stock): debe bloquear devolución y anulación
  v_p_new_adj := public.registrar_compra(
    v_sup, jsonb_build_array(jsonb_build_object('product_id', v_prod_notrack_seq, 'quantity', 5, 'cost', 100)),
    'efectivo', null, 95, 'pendiente', 19, false
  );
  PERFORM public.ajustar_stock(v_prod_notrack_seq, 7, 'Ajuste positivo post compra nueva');
  SELECT stock, cost INTO v_stock_before, v_cost_before FROM public.products WHERE id = v_prod_notrack_seq;
  SELECT count(*) INTO v_k_cnt_b FROM public.kardex WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_e_b FROM public.acc_entries WHERE company_id = v_co;
  SELECT count(*) INTO v_acc_l_b FROM public.acc_lines WHERE company_id = v_co;

  BEGIN
    PERFORM public.registrar_devolucion_compra(v_p_new_adj, v_prod_notrack_seq, 1, 'Bloqueo ajuste positivo', 'efectivo');
    RAISE EXCEPTION 'FAIL-N3a: permitió devolver compra tras ajuste positivo en kardex';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%existen ventas, ajustes o compras posteriores%' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.anular_compra(v_p_new_adj);
    RAISE EXCEPTION 'FAIL-N3b: permitió anular compra tras ajuste positivo en kardex';
  EXCEPTION WHEN OTHERS THEN
    IF SQLERRM NOT LIKE '%existen ventas, ajustes o recompras posteriores%' THEN RAISE; END IF;
  END;
  IF (SELECT stock FROM public.products WHERE id = v_prod_notrack_seq) <> v_stock_before
     OR (SELECT cost FROM public.products WHERE id = v_prod_notrack_seq) <> v_cost_before
     OR (SELECT count(*) FROM public.kardex WHERE company_id = v_co) <> v_k_cnt_b
